# Neon pooled connection string (Dashboard → Connection details → Pooled).
# Copy to `.env.local` and do not commit secrets.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# OpenAI Embeddings API (Prompt6+ saveChat / search).
OPENAI_API_KEY=
# Optional; default is text-embedding-3-small with 1536 dimensions (see src/db/schema.ts).
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
