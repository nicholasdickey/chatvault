# Copy to .env and set your Neon connection string (never commit .env).
# Neon: Dashboard → project → Connection details → URI (pooler is fine for server apps).
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
#
# Schema: run once against this URL before first deploy / after migration changes:
#   pnpm db:migrate
# Vercel does not run migrations on each cold start (avoids parallel CREATE races). Optional override:
# RUN_MIGRATIONS_ON_VERCEL=1

# MCP HTTP server (Prompt4+)
# MCP_PORT=3000
# MCP_HOST=127.0.0.1
# For ngrok / LAN testing use: MCP_HOST=0.0.0.0

# Jest / local e2e (Prompt5): start Postgres first:
#   docker compose -f docker-compose.test.yml up -d
# Optional override (pnpm test defaults to this URL if DATABASE_URL is unset):
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/chatvault_test

# OpenAI Embeddings (Prompt6+ saveChat / search)
# OPENAI_API_KEY=sk-...
# Optional; default text-embedding-3-small (1536 dimensions — must match DB vector column)
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
#
# E2E (Prompt9): default `pnpm test` runs Tier A (DB-seeded loadChats + validation) without OpenAI.
# Set OPENAI_API_KEY to also run Tier B (`saveChat`, save→load→search, searchChats with real embeddings).
# Optional CI: nightly/main merge jobs can set OPENAI_API_KEY (secret) to exercise Tier B.

# Vercel (serverless): Root Directory = chatvault-part2. Set DATABASE_URL + OPENAI_API_KEY in the dashboard.
# Entry: api/mcp.ts; public MCP URL is https://<deployment>.vercel.app/mcp (rewrite to /api/mcp).
# VERCEL_URL is set automatically; Host validation uses it plus optional MCP_ALLOWED_HOSTS:
# MCP_ALLOWED_HOSTS=preview-abc.vercel.app,your-custom-domain.com
